<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>org.example</groupId><artifactId>Casino</artifactId><version>1.0-SNAPSHOT</version></parent>
    <artifactId>casino-hall</artifactId>
    <dependencies>
        <dependency><groupId>org.example</groupId><artifactId>casino-api</artifactId></dependency>
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-fxml</artifactId></dependency>
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-media</artifactId></dependency>
        <dependency><groupId>org.example</groupId><artifactId>game-barkalov</artifactId><version>${project.version}</version><scope>runtime</scope></dependency>
        <dependency><groupId>org.example</groupId><artifactId>game-chernixa</artifactId><version>${project.version}</version><scope>runtime</scope></dependency>
        <dependency><groupId>org.example</groupId><artifactId>game-korentsov</artifactId><version>${project.version}</version><scope>runtime</scope></dependency>
        <dependency><groupId>org.example</groupId><artifactId>game-larin</artifactId><version>${project.version}</version><scope>runtime</scope></dependency>
        <dependency><groupId>org.example</groupId><artifactId>game-mogilevtsev</artifactId><version>${project.version}</version><scope>runtime</scope></dependency>
        <dependency><groupId>org.example</groupId><artifactId>game-putilin</artifactId><version>${project.version}</version><scope>runtime</scope></dependency>
        <dependency><groupId>org.example</groupId><artifactId>game-varganov</artifactId><version>${project.version}</version><scope>runtime</scope></dependency>
        <dependency><groupId>org.example</groupId><artifactId>game-orbita</artifactId><version>${project.version}</version><scope>runtime</scope></dependency>
        <dependency><groupId>org.example</groupId><artifactId>game-test-probe</artifactId><version>${project.version}</version><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId><artifactId>javafx-maven-plugin</artifactId><version>0.0.8</version>
                <configuration>
                    <mainClass>org.example.casino.hall/org.example.casino.hall.Launcher</mainClass>
                    <runtimePathOption>MODULEPATH</runtimePathOption>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>play</id>
            <build><plugins><plugin>
                <groupId>org.openjfx</groupId><artifactId>javafx-maven-plugin</artifactId>
                <executions><execution><id>open-catalog</id><phase>verify</phase><goals><goal>run</goal></goals></execution></executions>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
