<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.casino.hall.HelloController" styleClass="root">
    <top>
        <VBox styleClass="header" spacing="4">
            <padding><Insets top="20" right="26" bottom="18" left="26"/></padding>
            <HBox alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS" spacing="3">
                    <Label text="CASINO HALL" styleClass="hall-title"/>
                    <Label text="Выберите автомат и испытайте удачу" styleClass="hall-subtitle"/>
                </VBox>
                <Button fx:id="musicButton" text="♫ Музыка" onAction="#toggleMusic" styleClass="music-button"/>
                <VBox styleClass="balance-box" alignment="CENTER" spacing="1">
                    <Label text="ОБЩИЙ БАЛАНС" styleClass="balance-caption"/>
                    <Label fx:id="balance" text="🪙 0" styleClass="balance-value"/>
                </VBox>
            </HBox>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.28" styleClass="content-split">
            <items>
                <VBox spacing="10" styleClass="catalog-pane">
                    <padding><Insets top="18" right="14" bottom="18" left="18"/></padding>
                    <Label text="АВТОМАТЫ" styleClass="section-title"/>
                    <ListView fx:id="machines" VBox.vgrow="ALWAYS"/>
                    <Button fx:id="playButton" text="Открыть автомат" onAction="#openSelected" maxWidth="1.7976931348623157E308" styleClass="main-button"/>
                    <Button text="+ 5 монет" onAction="#addCoins" maxWidth="1.7976931348623157E308" styleClass="coin-button"/>
                </VBox>
                <VBox spacing="10" styleClass="games-pane">
                    <padding><Insets top="18" right="22" bottom="18" left="22"/></padding>
                    <Label text="Витрина игрового зала" styleClass="section-title"/>
                    <Label text="Баланс сохраняется при переходе между автоматами" styleClass="section-hint"/>
                    <FlowPane fx:id="cards" hgap="10" vgap="10" prefWrapLength="620" VBox.vgrow="ALWAYS" styleClass="cards"/>
                </VBox>
            </items>
        </SplitPane>
    </center>
    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT">
            <padding><Insets top="9" right="22" bottom="9" left="22"/></padding>
            <Label fx:id="status" text="Добавьте монеты в общий баланс и откройте любой автомат." wrapText="true"/>
        </HBox>
    </bottom>
</BorderPane>
