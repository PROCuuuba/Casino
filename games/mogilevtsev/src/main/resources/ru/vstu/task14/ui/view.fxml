<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="500.0" prefWidth="520.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.vstu.task14.ui.Controller">
    <top>
        <Label fx:id="infoLabel" styleClass="info" text="...">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
            </padding>
        </Label>
    </top>
    <center>
        <ImageView fx:id="view" fitWidth="380.0" pickOnBounds="true" preserveRatio="true" />
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="20.0">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding>
            <Button fx:id="payButton" onAction="#onPay" text="Заправить монетку" />
            <Button fx:id="startButton" onAction="#onStart" text="Начать игру" />
        </HBox>
    </bottom>
</BorderPane>
